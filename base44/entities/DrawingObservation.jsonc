{
  "name": "DrawingObservation",
  "type": "object",
  "description": "A factual, non-diagnostic note the parent saves about a drawing or a moment of expression. Only what the parent actually wrote is ever stored.",
  "properties": {
    "child_id": {
      "type": "string"
    },
    "drawing_id": {
      "type": "string",
      "description": "Optional drawing this observation belongs to"
    },
    "body": {
      "type": "string"
    },
    "kind": {
      "type": "string",
      "enum": [
        "observation",
        "conversation"
      ],
      "enumColors": [
        "purple",
        "blue"
      ],
      "default": "observation"
    }
  },
  "required": [
    "child_id",
    "body"
  ],
  "rls": {
    "read": {
      "$or": [
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "create": {
      "$or": [
        {
          "user_condition": {
            "role": "user"
          }
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "update": {
      "$or": [
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "delete": {
      "$or": [
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    }
  }
}