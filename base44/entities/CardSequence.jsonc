{
  "type": "object",
  "name": "CardSequence",
  "description": "A row of communication cards a child put together to express something.",
  "properties": {
    "child_id": {
      "type": "string"
    },
    "card_keys": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "description": "Ordered card ids, e.g. i_want + water"
    },
    "categories": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "spoken": {
      "type": "boolean",
      "description": "Whether it was read aloud"
    }
  },
  "required": [
    "child_id",
    "card_keys"
  ],
  "rls": {
    "read": {
      "$or": [
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "create": {
      "$or": [
        {
          "user_condition": {
            "role": "user"
          }
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "update": {
      "$or": [
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "delete": {
      "$or": [
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    }
  }
}