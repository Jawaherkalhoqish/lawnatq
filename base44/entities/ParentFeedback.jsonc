{
  "name": "ParentFeedback",
  "type": "object",
  "description": "Feedback a parent submits about LAWNATQ activities and the website, owned by that parent.",
  "properties": {
    "parent_id": {
      "type": "string",
      "description": "The parent account that submitted this feedback"
    },
    "rating": {
      "type": "number",
      "description": "Experience rating from 1 to 5"
    },
    "comment": {
      "type": "string",
      "description": "The parent's comment or suggestion, exactly as written"
    },
    "topic": {
      "type": "string",
      "enum": [
        "activities",
        "website",
        "specialists",
        "other"
      ],
      "enumColors": [
        "purple",
        "blue",
        "green",
        "gray"
      ],
      "default": "other"
    }
  },
  "required": [
    "parent_id",
    "rating",
    "comment"
  ],
  "rls": {
    "read": {
      "$or": [
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "create": {
      "$or": [
        {
          "user_condition": {
            "role": "user"
          }
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "update": {
      "$or": [
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "delete": {
      "$or": [
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    }
  }
}