{
  "type": "object",
  "name": "Child",
  "description": "A child profile created and managed by a parent.",
  "properties": {
    "name": {
      "type": "string",
      "description": "The preferred name the child is called by"
    },
    "age": {
      "type": "number",
      "description": "Age in years (5-10)"
    },
    "avatar_color": {
      "type": "string",
      "enum": [
        "sun",
        "turq",
        "coral",
        "lav",
        "sky",
        "rose"
      ],
      "enumColors": [
        "yellow",
        "green",
        "red",
        "purple",
        "blue",
        "pink"
      ],
      "default": "sun",
      "description": "Color of the child's avatar bubble"
    },
    "interests": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "description": "Things the child enjoys"
    },
    "language": {
      "type": "string",
      "enum": [
        "ar",
        "en"
      ],
      "enumColors": [
        "blue",
        "purple"
      ],
      "default": "ar"
    },
    "communication_preference": {
      "type": "string",
      "enum": [
        "cards",
        "speech",
        "mixed"
      ],
      "enumColors": [
        "blue",
        "green",
        "purple"
      ],
      "default": "mixed",
      "description": "How the child prefers to communicate"
    },
    "support_note": {
      "type": "string",
      "enum": [
        "down_syndrome",
        "other_support_needs",
        "prefer_not_to_say"
      ],
      "enumColors": [
        "blue",
        "purple",
        "gray"
      ],
      "default": "prefer_not_to_say",
      "description": "Optional parent-provided context. Never shown in the child experience."
    },
    "parent_notes": {
      "type": "string",
      "description": "Private notes for the parent"
    },
    "accessibility_notes": {
      "type": "string",
      "description": "Accessibility preferences the parent wants remembered"
    },
    "voice_enabled": {
      "type": "boolean",
      "default": true,
      "description": "Read buttons and stories aloud"
    },
    "favorite_cards": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "description": "Ids of cards the child marked as favourite"
    }
  },
  "required": [
    "name"
  ],
  "rls": {
    "read": {
      "$or": [
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "create": {
      "$or": [
        {
          "user_condition": {
            "role": "user"
          }
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "update": {
      "$or": [
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "delete": {
      "$or": [
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    }
  }
}