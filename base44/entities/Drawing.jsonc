{
  "type": "object",
  "name": "Drawing",
  "description": "A drawing or coloring saved from the child's studio.",
  "properties": {
    "child_id": {
      "type": "string",
      "description": "The child this drawing belongs to"
    },
    "title": {
      "type": "string"
    },
    "file_uri": {
      "type": "string",
      "description": "Private storage URI of the exported PNG"
    },
    "template": {
      "type": "string",
      "description": "Coloring template id, or free for a blank canvas"
    },
    "colors_used": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "description": "Brand color names the child painted with"
    },
    "child_note": {
      "type": "string",
      "description": "Optional words the child added about the drawing"
    }
  },
  "required": [
    "child_id"
  ],
  "rls": {
    "read": {
      "$or": [
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "create": {
      "$or": [
        {
          "user_condition": {
            "role": "user"
          }
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "update": {
      "$or": [
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "delete": {
      "$or": [
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    }
  }
}