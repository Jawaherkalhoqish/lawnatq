{
  "name": "SpecialistAvailability",
  "type": "object",
  "description": "One bookable slot for a specialist. Only administrators create slots; a booking marks the slot as booked.",
  "properties": {
    "specialist_id": {
      "type": "string"
    },
    "start_at": {
      "type": "string",
      "format": "date-time"
    },
    "duration_minutes": {
      "type": "number",
      "default": 45
    },
    "is_booked": {
      "type": "boolean",
      "default": false
    }
  },
  "required": [
    "specialist_id",
    "start_at"
  ],
  "rls": {
    "read": {
      "$or": [
        {
          "user_condition": {
            "role": "user"
          }
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "create": {
      "user_condition": {
        "role": "admin"
      }
    },
    "update": {
      "user_condition": {
        "role": "admin"
      }
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}